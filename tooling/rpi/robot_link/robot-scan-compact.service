[Unit]
Description=/scan as integer mm (/scan_compact) for the dashboard over rosbridge
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/bin/bash -c 'source /home/ubuntu/robot_link/ros_env.sh && exec python3 /home/ubuntu/robot_link/scan_compact_node.py'
KillSignal=SIGINT
TimeoutStopSec=5
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
