{
  "id": "limits_layout_1280",
  "title": "1280x800 창: 속도 한계 줄(세 슬라이더 · 값 · 자물쇠)과 조종 줄(비상 정지까지)이 겹치지 않음 — 한 줄 고정 상태 캡처",
  "needs_pi": false,
  "needs_human": false,
  "server_args": [],
  "dashboard_args": ["--size", "1280x800"],
  "actions": [
    {"wait": "bridge.connected", "timeout_s": 10},
    {"wait": "dash.limitsSupport", "timeout_s": 8},
    {"t": 1, "call": "robot.limits.setLocked", "args": ["max_reverse", true]},
    {"t": 3, "shot": "{out}/limits_1280.png"}
  ],
  "duration_s": 5,
  "expect": {
    "exit_code": 0,
    "log_forbid": ["TypeError", "ReferenceError", "Binding loop"],
    "state": [
      {"path": "win.width", "op": "==", "value": 1280},
      {"path": "dash.limitsFit", "op": "==", "value": true},
      {"path": "dash.limitsSupport", "op": "==", "value": 1},
      {"path": "dash.limitsWarn", "op": "==", "value": "0,0,0"}
    ]
  }
}
