{
  "id": "limits_keyboard",
  "title": "속도 한계(병렬 시나리오 창이 포커스를 가져가면 페이지가 0 을 보내므로 구간마다 drive 를 세 번 부른다): 전진 0.2 · 후진 0.1 · 회전 0.4 로 정하면 키보드 전진 · 후진 · 회전이 넘지 않음 · 최대 속도 위끝 = 최대 전진 · 자물쇠 고정 뒤 바꾸기 무시 · 워치독이 범위 밖(0.5) 거부",
  "needs_pi": false,
  "needs_human": false,
  "server_args": [],
  "dashboard_args": [],
  "actions": [
    {"wait": "bridge.connected", "timeout_s": 10},
    {"wait": "dash.limitsSupport", "timeout_s": 8},
    {"t": 1, "call": "robot.limits.setLimit", "args": ["max_forward", 0.2]},
    {"t": 1, "call": "robot.limits.setLimit", "args": ["max_reverse", 0.1]},
    {"t": 1, "call": "robot.limits.setLimit", "args": ["max_angular", 0.4]},
    {"t": 1.5, "set": "robot.maxSpeed", "value": 0.35},
    {"t": 2, "call": "robot.armTeleop", "args": [true]},
    {"t": 2.2, "call": "robot.drive", "args": [1, 0]},
    {"t": 2.5, "call": "robot.drive", "args": [1, 0]},
    {"t": 2.8, "call": "robot.drive", "args": [1, 0]},
    {"t": 3.2, "call": "robot.drive", "args": [-1, 0]},
    {"t": 3.5, "call": "robot.drive", "args": [-1, 0]},
    {"t": 3.8, "call": "robot.drive", "args": [-1, 0]},
    {"t": 4.2, "call": "robot.drive", "args": [0, 1]},
    {"t": 4.5, "call": "robot.drive", "args": [0, 1]},
    {"t": 4.8, "call": "robot.drive", "args": [0, 1]},
    {"t": 5.2, "call": "robot.drive", "args": [1, -1]},
    {"t": 5.5, "call": "robot.drive", "args": [1, -1]},
    {"t": 5.8, "call": "robot.drive", "args": [1, -1]},
    {"t": 6.2, "call": "robot.drive", "args": [0, 0]},
    {"t": 6.5, "call": "robot.limits.setLocked", "args": ["max_forward", true]},
    {"t": 6.7, "call": "robot.limits.setLimit", "args": ["max_forward", 0.3]},
    {"t": 7, "call": "robot.drive", "args": [1, 0]},
    {"t": 7.3, "call": "robot.drive", "args": [1, 0]},
    {"t": 7.6, "call": "robot.drive", "args": [1, 0]},
    {"t": 8, "call": "robot.drive", "args": [0, 0]},
    {"t": 8.2, "set": "win.page", "value": 1},
    {"t": 8.3, "set": "inspector.tab", "value": "파라미터"},
    {"t": 8.4, "set": "paramClient.node", "value": "/cmd_watchdog"},
    {"t": 8.5, "call": "paramClient.refresh", "args": []},
    {"t": 10, "call": "paramClient.set", "args": ["max_forward", 0.5]},
    {"t": 11.5, "set": "win.page", "value": 0},
    {"t": 12.5, "shot": "{out}/limits.png"}
  ],
  "duration_s": 14,
  "expect": {
    "exit_code": 0,
    "log_forbid": ["TypeError", "ReferenceError", "Binding loop"],
    "state": [
      {"path": "robot.maxSpeed", "op": "==", "value": 0.2},
      {"path": "dash.limitFwd", "op": "==", "value": 0.2},
      {"path": "dash.limitFwdSliderEnabled", "op": "==", "value": false},
      {"path": "dash.limitsSupport", "op": "==", "value": 1},
      {"path": "dash.limitsWarn", "op": "==", "value": "0,0,0"},
      {"path": "dash.limitsFit", "op": "==", "value": true},
      {"path": "inspector.paramLastSuccessful", "op": "==", "value": false}
    ],
    "server_log": [
      {"rule": "value_between", "topic": "/teleop/cmd_vel", "field": "linear.x", "min": -0.1, "max": 0.2},
      {"rule": "max_abs", "topic": "/teleop/cmd_vel", "field": "angular.z", "value": 0.4},
      {"rule": "count_ge", "topic": "/teleop/cmd_vel", "where": {"linear.x": 0.2}, "value": 5},
      {"rule": "count_ge", "topic": "/teleop/cmd_vel", "where": {"linear.x": -0.1}, "value": 3},
      {"rule": "count_ge", "topic": "/teleop/cmd_vel", "where": {"angular.z": 0.4}, "value": 3},
      {"rule": "count_ge", "topic": "/teleop/cmd_vel", "where": {"angular.z": -0.4}, "value": 3},
      {"rule": "count_ge", "op": "call_service", "service": "/cmd_watchdog/set_parameters", "value": 1}
    ]
  }
}
