{
  "id": "insp_diag",
  "title": "--diag-stale 3: 진단 3 항목이 첫 연결 3 s 뒤 멈추고 5 s 뒤 모두 STALE",
  "needs_pi": false,
  "needs_human": false,
  "server_args": [
    "--diag-stale",
    "3"
  ],
  "dashboard_args": [],
  "duration_s": 11,
  "actions": [
    {
      "wait": "bridge.connected",
      "timeout_s": 10
    },
    {
      "t": 0.5,
      "set": "win.page",
      "value": 1
    },
    {
      "t": 0.6,
      "set": "inspector.tab",
      "value": "진단"
    },
    {
      "t": 10,
      "shot": "diag.png"
    }
  ],
  "expect": {
    "log_forbid": [
      "TypeError",
      "ReferenceError",
      "Binding loop"
    ],
    "state": [
      {
        "path": "inspector.diagCount",
        "op": "==",
        "value": 3
      },
      {
        "path": "inspector.diagStaleCount",
        "op": "==",
        "value": 3
      },
      {
        "path": "inspector.diagSynthetic",
        "op": "==",
        "value": false
      }
    ],
    "server_log": [
      {
        "rule": "count_ge",
        "op": "subscribe",
        "topic": "/diagnostics",
        "value": 1
      },
      {
        "rule": "count_ge",
        "dir": "tx",
        "topic": "/diagnostics",
        "value": 1
      }
    ]
  }
}
