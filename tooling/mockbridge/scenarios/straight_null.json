{
  "id": "straight_null",
  "title": "--null-heading: heading_err_deg null 이면 heading 키 없음(화면 '—')으로 처리하고 죽지 않음",
  "needs_pi": false,
  "needs_human": false,
  "server_args": [
    "--null-heading"
  ],
  "dashboard_args": [],
  "actions": [
    {
      "wait": "bridge.connected",
      "timeout_s": 10
    },
    {
      "t": 2.5,
      "call": "robot.armTeleop",
      "args": [
        true
      ]
    },
    {
      "t": 3,
      "call": "robot.straight",
      "args": [
        0.5
      ]
    }
  ],
  "duration_s": 25,
  "expect": {
    "log_forbid": [
      "TypeError",
      "ReferenceError",
      "Binding loop"
    ],
    "state": [
      {
        "path": "bridge.connected",
        "op": "==",
        "value": true
      },
      {
        "path": "robot.straightResult.reason",
        "op": "==",
        "value": "reached"
      },
      {
        "path": "robot.straightResult.heading",
        "op": "missing"
      }
    ]
  }
}
