{
  "id": "safety_locked_paths",
  "title": "B2: 잠김 · 비상 정지 뒤(잠금 유지)에는 straight · sendGoal 이 나가지 않고, sendGoal 이 정지 모드를 바꾸지 않음",
  "needs_pi": false,
  "needs_human": false,
  "server_args": [],
  "dashboard_args": [],
  "actions": [
    {"wait": "bridge.connected", "timeout_s": 10},
    {"t": 2, "call": "robot.straight", "args": [1.0]},
    {"t": 2.5, "call": "robot.straight", "args": [-1.0]},
    {"t": 3, "call": "robot.sendGoal", "args": [1.0, 0.0, 0.0]},
    {"t": 4, "call": "robot.armTeleop", "args": [true]},
    {"t": 4.5, "call": "robot.estop", "args": []},
    {"t": 5, "call": "robot.sendGoal", "args": [1.0, 0.0, 0.0]},
    {"t": 5.3, "shot": "estop_mode.png"},
    {"t": 5.5, "set": "robot.mode", "value": "키보드 조종"},
    {"t": 6, "call": "robot.straight", "args": [1.0]},
    {"t": 6.5, "call": "robot.sendGoal", "args": [1.0, 0.0, 0.0]}
  ],
  "duration_s": 9,
  "expect": {
    "log_forbid": ["TypeError", "ReferenceError", "Binding loop"],
    "state": [
      {"path": "bridge.connected", "op": "==", "value": true},
      {"path": "robot.mode", "op": "==", "value": "키보드 조종"},
      {"path": "robot.teleopArmed", "op": "==", "value": false}
    ],
    "server_log": [
      {"rule": "count_le", "topic": "/straight_drive/goal", "value": 0},
      {"rule": "count_le", "topic": "/goal_pose", "value": 0},
      {"rule": "zero_after_action", "action": "robot.estop", "topic": "/teleop/cmd_vel", "fields": ["linear.x", "angular.z"], "after_ms": 0}
    ]
  }
}
